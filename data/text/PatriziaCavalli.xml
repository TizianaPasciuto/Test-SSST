               <div>
				  <pb n="PatriziaCavalli_01" xml:id="PatriziaCavalli_01"/>				  
                      <p xml:id="PatriziaCavalli_01_001" n="1">Qualcuno mi ha detto</p>
					  <p xml:id="PatriziaCavalli_01_002" n="2">che certo le mie poesie</p>
					  <p xml:id="PatriziaCavalli_01_003" n="3">non cambieranno il mondo.</p>
					  <p xml:id="PatriziaCavalli_01_004" n="4">Io rispondo che certo sì</p>
					  <p xml:id="PatriziaCavalli_01_005" n="5">le mie poesie</p>
					  <p xml:id="PatriziaCavalli_01_006" n="6">non cambieranno il mondo.</p>
